{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Visual Studio Code",
  "author": "Microsoft's Visual Studio Code colours (Dark Modern, over Dark+), written in Zed's format",
  "themes": [
    {
      "name": "Dark Modern",
      "appearance": "dark",
      "style": {
        "background": "#181818ff",
        "surface.background": "#181818ff",
        "editor.background": "#1f1f1fff",
        "element.hover": "#2a2d2eff",
        "element.selected": "#37373dff",
        "border": "#2b2b2bff",
        "border.variant": "#313131ff",
        "border.focused": "#0078d4ff",
        "text": "#ccccccff",
        "text.muted": "#9d9d9dff",
        "text.placeholder": "#989898ff",
        "text.accent": "#4daafcff",
        "editor.line_number": "#6e7681",
        "editor.active_line_number": "#cccccc",
        "created": "#2ea043ff",
        "modified": "#0078d4ff",
        "deleted": "#f85149ff",
        "scrollbar.thumb.background": "#79797966",
        "players": [
          {
            "cursor": "#aeafadff",
            "selection": "#264f78ff"
          }
        ],
        "syntax": {
          "keyword": {
            "color": "#569cd6"
          },
          "string": {
            "color": "#ce9178"
          },
          "string.escape": {
            "color": "#d7ba7d"
          },
          "string.regex": {
            "color": "#d16969"
          },
          "function": {
            "color": "#dcdcaa"
          },
          "type": {
            "color": "#4ec9b0"
          },
          "comment": {
            "color": "#6a9955"
          },
          "comment.doc": {
            "color": "#6a9955"
          },
          "number": {
            "color": "#b5cea8"
          },
          "constant": {
            "color": "#4fc1ff"
          },
          "boolean": {
            "color": "#569cd6"
          },
          "attribute": {
            "color": "#9cdcfe"
          },
          "property": {
            "color": "#9cdcfe"
          },
          "variable": {
            "color": "#9cdcfe"
          },
          "punctuation": {
            "color": "#cccccc"
          },
          "operator": {
            "color": "#d4d4d4"
          },
          "tag": {
            "color": "#569cd6"
          },
          "title": {
            "color": "#569cd6"
          },
          "namespace": {
            "color": "#4ec9b0"
          },
          "preproc": {
            "color": "#c586c0"
          },
          "label": {
            "color": "#c586c0"
          },
          "keyword.control": {
            "color": "#c586c0"
          }
        }
      }
    }
  ]
}
