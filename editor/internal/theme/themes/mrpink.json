{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Mr Pink",
  "author": "juanmnl's Mr Pink for Visual Studio Code, written in Zed's format",
  "themes": [
    {
      "name": "Mr Pink",
      "appearance": "dark",
      "style": {
        "background": "#1e1e25ff",
        "surface.background": "#1e1e25ff",
        "editor.background": "#25252fff",
        "element.hover": "#17171cff",
        "element.selected": "#131318ff",
        "border": "#2f2f3bff",
        "border.variant": "#25252fff",
        "border.focused": "#d58fdbff",
        "text": "#f6f8f7ff",
        "text.muted": "#b4c1d0ff",
        "text.placeholder": "#6b6d8cff",
        "text.accent": "#d58fdbff",
        "editor.line_number": "#3e3f50",
        "editor.active_line_number": "#b4c1d0",
        "created": "#84eea7ff",
        "modified": "#fad481ff",
        "deleted": "#ff6057ff",
        "scrollbar.thumb.background": "#f6f8f733",
        "players": [
          {
            "cursor": "#d58fdbff",
            "selection": "#62636aff"
          }
        ],
        "syntax": {
          "keyword": {
            "color": "#d167b5"
          },
          "keyword.control": {
            "color": "#d58fdb"
          },
          "string": {
            "color": "#b4c1d0"
          },
          "string.escape": {
            "color": "#ffffff"
          },
          "string.regex": {
            "color": "#b4c1d0"
          },
          "function": {
            "color": "#ffffff"
          },
          "type": {
            "color": "#a8c3c8"
          },
          "comment": {
            "color": "#525863"
          },
          "comment.doc": {
            "color": "#525863"
          },
          "number": {
            "color": "#fad481"
          },
          "constant": {
            "color": "#a8c3c8"
          },
          "boolean": {
            "color": "#b4c1d0"
          },
          "attribute": {
            "color": "#d58fdb"
          },
          "property": {
            "color": "#d58fdb"
          },
          "variable": {
            "color": "#f6f8f7"
          },
          "punctuation": {
            "color": "#a8c3c8"
          },
          "operator": {
            "color": "#d58fdb"
          },
          "tag": {
            "color": "#d167b5"
          },
          "title": {
            "color": "#b4c1d0"
          },
          "namespace": {
            "color": "#b4c1d0"
          },
          "preproc": {
            "color": "#fad481"
          },
          "label": {
            "color": "#d58fdb"
          }
        }
      }
    }
  ]
}
